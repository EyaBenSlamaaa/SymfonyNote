{% extends 'base.html.twig' %}

{% block title %}Home Page{% endblock %}

{% block stylesheets %}
    <style>
        body {
            background: url('https://onlinenotepad.org/img/bg.svg') no-repeat center center fixed;
            background-size: cover;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        h1 {
            text-align: center;
            margin: 50px 0 20px;
            color: #333;
        }

        .notes-container {
            max-width: 1000px;
            margin: auto;
            background-color: rgba(255, 255, 255, 0.95);
            padding: 30px;
            border-radius: 18px;
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15);
        }

        .notes-title {
            margin-bottom: 20px;
            color: #333;
        }

        .note-cta {
            text-align: right;
            margin-bottom: 20px;
        }

        .btn-success {
            background-color: #28a745;
            border: none;
            padding: 8px 16px;
            color: #fff;
            font-weight: bold;
            border-radius: 6px;
            text-decoration: none;
        }

        .btn-success:hover {
            background-color: #218838;
        }

        .alert {
            margin-bottom: 20px;
        }

        .empty-notes {
            text-align: center;
            font-size: 18px;
            color: #666;
            margin-top: 40px;
        }

        .notes-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
        }

        .note-block {
            background-color: #fdfdfd;
            padding: 20px;
            border-radius: 12px;
            border: 1px solid #ddd;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.08);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .note-text {
            font-size: 15px;
            color: #444;
            margin-bottom: 15px;
            white-space: pre-wrap;
        }

        .note-actions {
            display: flex;
            justify-content: space-between;
        }

        .btn-edit,
        .btn-delete {
            text-decoration: none;
            padding: 6px 12px;
            border-radius: 5px;
            font-size: 14px;
            font-weight: 500;
            color: #fff;
        }

        .btn-edit {
            background-color: #007bff;
        }

        .btn-edit:hover {
            background-color: #0056b3;
        }

        .btn-delete {
            background-color: #dc3545;
        }

        .btn-delete:hover {
            background-color: #b02a37;
        }

        @media (max-width: 600px) {
            .note-actions {
                flex-direction: column;
                gap: 10px;
            }

            .btn-edit,
            .btn-delete {
                width: 100%;
                text-align: center;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <h1>Start writing your notes</h1>
    <!-- Notes section -->
    <div class="notes-container">
        <h3 class="notes-title">Notes</h3>
        
        <div class="note-cta">
            <a href="{{ path('notes_new') }}" class="btn btn-success">
               <i class="bi bi-clipboard2-plus me-1"></i> Add a Note
            </a>
        </div>
        
        {# Display flash messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
        {% endfor %}

        {% if notes is empty %}
            <div class="empty-notes">
                <p>Start by adding your first note</p>
            </div>
        {% else %}
            <div class="notes-grid">
                {% for note in notes %}
                    <div class="note-block">
                        <p class="note-text">{{ note.noteText }}</p>
                        <div class="note-actions">
                            <a href="{{ path('notes_edit', {'id': note.id}) }}" class="btn-edit">
    <i class="bi bi-pencil-square me-1"></i> Edit
</a>
<a href="{{ path('notes_delete', {'id': note.id}) }}" class="btn-delete" onclick="return confirm('Are you sure you want to delete this note?')">
    <i class="bi bi-trash me-1"></i> Delete
</a>

                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
